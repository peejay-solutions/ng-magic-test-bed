{
  "name": "ng-magic-test-bed-presentation",
  "description": "A magic test bed for angular",
  "repository": {
    "type": "git",
    "url": "https://github.com/peejay-solutions/ng-magic-test-bed"
  },
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "testLib": "ng run ng-magic-test-bed:test",
    "copyLlms": "xcopy /s /y \".\\projects\\ng-magic-test-bed\\llms.txt\" \".\\dist\\ng-magic-test-bed\\\"",
    "buildLib": "ng run ng-magic-test-bed:build:production && npm run copyLlms",
    "compodoc": "npx compodoc -p ./tsconfig.doc.json projects -d ../docs/"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.18",
    "@angular/common": "^21.2.18",
    "@angular/compiler": "^21.2.18",
    "@angular/core": "^21.2.18",
    "@angular/forms": "^21.2.18",
    "@angular/platform-browser": "^21.2.18",
    "@angular/platform-browser-dynamic": "^21.2.18",
    "@angular/router": "^21.2.18",
    "@peejay-solutions/ng-magic-test-bed": "^1.2.9",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.19",
    "@angular/cli": "^21.2.19",
    "@angular/compiler-cli": "^21.2.18",
    "@types/jasmine": "~4.3.0",
    "jasmine-core": "~4.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^21.2.5",
    "typescript": "~5.9.3"
  }
}
